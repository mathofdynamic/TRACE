NODE_ENV=production
DATABASE_URL=postgresql://trace_staging:REPLACE@127.0.0.1:5432/trace_staging
TRACE_AUTH_SECRET=REPLACE_WITH_SECRET_STORE_VALUE
TRACE_PUBLIC_URL=https://staging.trace.example.invalid
GITHUB_OAUTH_CLIENT_ID=staging-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=REPLACE_WITH_SECRET_STORE_VALUE
GITHUB_APP_ID=staging-github-app-id
GITHUB_APP_CLIENT_ID=staging-github-app-client-id
GITHUB_APP_CLIENT_SECRET=REPLACE_WITH_SECRET_STORE_VALUE
GITHUB_APP_PRIVATE_KEY=REPLACE_WITH_SECRET_STORE_VALUE
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_SECRET_STORE_VALUE
GITHUB_APP_SLUG=staging-github-app-slug
GITHUB_APP_CALLBACK_URL=https://staging.trace.example.invalid/api/github/setup
# Leave unset when the GitHub App requests user authorization during installation.
GITHUB_APP_SETUP_URL=
GITHUB_APP_INSTALL_URL=https://github.com/apps/staging-github-app-slug/installations/new
TRACE_FEATURE_SEMANTIC_PR_FINDINGS=false
TRACE_FEATURE_SEMANTIC_CONFLICTS=false
TRACE_FEATURE_GITHUB_COMMENTS=false
TRACE_FEATURE_HYBRID_SYNC=false
