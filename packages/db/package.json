{
  "name": "@trace/db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:d1:generate": "drizzle-kit generate --config drizzle.d1.config.ts",
    "db:d1:migrate:local": "wrangler d1 migrations apply trace-d1-local --local --config wrangler.d1.jsonc",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@trace/core": "workspace:*",
    "@trace/env": "workspace:*",
    "drizzle-orm": "0.44.5",
    "pg": "8.16.3",
    "pg-cloudflare": "1.4.0"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.4",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
