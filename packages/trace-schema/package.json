{
  "name": "@trace/schema",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "trace-schema": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "yaml": "2.8.1",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
