{
  "name": "@trace/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "cf:dev": "wrangler dev --config wrangler.cf1.jsonc --local",
    "cf:typegen": "wrangler types src/bindings.generated.d.ts --config wrangler.cf1.jsonc",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@trace/core": "workspace:*",
    "@trace/db": "workspace:*",
    "@trace/env": "workspace:*",
    "@trace/logger": "workspace:*",
    "drizzle-orm": "0.44.5",
    "pg-boss": "12.5.0"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "tsx": "4.20.3",
    "vitest": "3.2.4"
  }
}
