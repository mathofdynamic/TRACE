{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "trace-test",
  "account_id": "c5d6cf110905c91fc3eed1abaf8236a2",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "vars": {
    "TRACE_DEPLOYMENT_ENV": "test",
    "NEXT_PRIVATE_MINIMAL_MODE": "1",
    "TRACE_FEATURE_SEMANTIC_PR_FINDINGS": "false",
    "TRACE_FEATURE_SEMANTIC_CONFLICTS": "false",
    "TRACE_FEATURE_GITHUB_COMMENTS": "false",
    "TRACE_FEATURE_HYBRID_SYNC": "false",
  },
  "env": {
    "local-d1": {
      "name": "trace-test-local-d1",
      "main": "custom-worker.ts",
      "workers_dev": true,
      "vars": {
        "TRACE_DEPLOYMENT_ENV": "local-d1",
        "TRACE_DATABASE_DRIVER": "d1",
        "TRACE_PUBLIC_URL": "http://localhost:8787",
        "NEXT_PRIVATE_MINIMAL_MODE": "1",
        "TRACE_FEATURE_SEMANTIC_PR_FINDINGS": "false",
        "TRACE_FEATURE_SEMANTIC_CONFLICTS": "false",
        "TRACE_FEATURE_GITHUB_COMMENTS": "false",
        "TRACE_FEATURE_HYBRID_SYNC": "false",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "trace-d1-local",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "../../packages/db/drizzle-d1",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "TRACE_QUEUE",
            "queue": "trace-jobs-local-d1",
          },
        ],
        "consumers": [
          {
            "queue": "trace-jobs-local-d1",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "retry_delay": 60,
          },
        ],
      },
    },
    "staging": {
      "name": "trace-test-staging",
      "main": "custom-worker.ts",
      "workers_dev": true,
      "vars": {
        "TRACE_DEPLOYMENT_ENV": "staging",
        "TRACE_DATABASE_DRIVER": "d1",
        "NEXT_PRIVATE_MINIMAL_MODE": "1",
        "TRACE_PUBLIC_URL": "https://trace-code.pages.dev",
        "TRACE_FEATURE_SEMANTIC_PR_FINDINGS": "false",
        "TRACE_FEATURE_SEMANTIC_CONFLICTS": "false",
        "TRACE_FEATURE_GITHUB_COMMENTS": "false",
        "TRACE_FEATURE_HYBRID_SYNC": "false",
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "2d1e4821c1484d6299d88e29f2884310",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "trace-test-staging-db",
          "database_id": "c4df63bc-8270-4500-9dab-c1c6439efa64",
          "migrations_dir": "../../packages/db/drizzle-d1",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "TRACE_QUEUE",
            "queue": "trace-staging-jobs",
          },
        ],
        "consumers": [
          {
            "queue": "trace-staging-jobs",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "retry_delay": 60,
          },
        ],
      },
    },
  },
}
